import { Text } from "@react-three/drei";
import { FESTIVAL } from "@/config/festival";

const FONT = "/fonts/Format_1452.ttf";
const WHITE = "#f4f1ea";
const FS = 1.0; // title line size (world units)
const LINE = 1.5; // vertical gap between title lines (leading)
const DATE_FS = 0.5;
const DATE_GAP = 1.15; // gap from the last title line down to the date
const CY = 0.4; // vertical centre of the lockup
const Z = 3.5; // in front of the cables (they sit at z up to ~2.9) so it floats on top

const LINES = ["ADVENTUROUS", "ELECTRIC GUITAR", "FESTIVAL"];

/**
 * The title lockup rendered as 3D text in the scene (so the cables can pass in
 * front of it). Toggled against the DOM overlay via TITLE_MODE in config/ui.
 */
export function TitleText3D() {
  return (
    <group position={[0, CY, Z]}>
      {LINES.map((line, i) => (
        <Text
          key={line}
          font={FONT}
          fontSize={FS}
          color={WHITE}
          anchorX="center"
          anchorY="middle"
          letterSpacing={0.06}
          position={[0, LINE - i * LINE, 0]}
        >
          {line}
        </Text>
      ))}
      <Text
        font={FONT}
        fontSize={DATE_FS}
        color={WHITE}
        anchorX="center"
        anchorY="middle"
        letterSpacing={0.14}
        position={[0, -LINE - DATE_GAP, 0]}
      >
        {FESTIVAL.dates.toUpperCase()}
      </Text>
    </group>
  );
}
