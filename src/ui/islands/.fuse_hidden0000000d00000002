import { SCHEDULE, ONGOING, VENUES } from "@/config/sections";
import { Island } from "./Island";

type Spec = { id: string; top?: string; title: string; sub?: string; note?: string };

function buildSpecs(): Spec[] {
  const specs: Spec[] = [];
  ONGOING.forEach((o, i) =>
    specs.push({ id: `ong${i}`, top: o.when, title: o.title, sub: o.venue, note: o.note }),
  );
  SCHEDULE.forEach((day) =>
    day.blocks.forEach((b) =>
      b.slots.forEach((s, i) =>
        specs.push({
          id: `${day.date}${b.venue}${i}`.replace(/\W+/g, "").toLowerCase(),
          top: `${day.date} · ${s.time}`,
          title: s.title,
          sub: s.performers ?? b.venue,
          note: s.performers ? b.venue : s.note,
        }),
      ),
    ),
  );
  VENUES.forEach((v, i) =>
    specs.push({ id: `ven${i}`, top: "Venue", title: v.name, sub: v.org, note: v.note }),
  );
  return specs;
}

const SPECS = buildSpecs();
const ALIGN: ("flex-start" | "center" | "flex-end")[] = ["flex-start", "flex-end", "center"];
const ROT = [-3, 2.5, -1.5, 3, -2, 1.5];

/** The scroll stream of floating islands (events, then venues). */
export function IslandField() {
  return (
    <div
      className="ags-island-field"
      style={{
        display: "flex",
        flexDirection: "column",
        gap: "12svh",
        padding: "6svh clamp(1rem, 5vw, 4rem) 22svh",
      }}
    >
      {SPECS.map((s, i) => (
        <div
          key={s.id}
          style={{
            alignSelf: ALIGN[i % ALIGN.length],
            width: "min(86vw, 34rem)",
            transform: `rotate(${ROT[i % ROT.length]}deg)`,
            filter: "drop-shadow(0 12px 34px rgba(0, 0, 0, 0.65))",
          }}
        >
          <Island {...s} />
        </div>
      ))}
    </div>
  );
}
